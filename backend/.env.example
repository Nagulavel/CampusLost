# Environment variables — copy to .env and fill in your values
# NEVER commit the actual .env file to GitHub

# MongoDB Atlas connection string
# Get this from: Atlas → Your Cluster → Connect → Connect your application
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Server port (Vercel sets this automatically)
PORT=5000

# Environment
NODE_ENV=development

# Your frontend URL (for CORS in production)
# Example: https://campusfind.vercel.app
FRONTEND_URL=http://localhost:3000
